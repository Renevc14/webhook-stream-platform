{
  "containerDefinitions": [
    {
      "name": "webhook-gateway",
      "image": "262252232181.dkr.ecr.eu-west-2.amazonaws.com/stg-webhook-gateway:pulse-ensure",
      "cpu": 0,
      "portMappings": [
        {
          "containerPort": 3020,
          "hostPort": 3020,
          "protocol": "tcp",
          "name": "gateway-port"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "ENCRYPT_TOOL_INTERNAL_URL",
          "value": "https://api.prodactivelabs.com"
        },
        {
          "name": "ENVIRONMENT",
          "value": "staging"
        },
        {
          "name": "GATEWAY_PORT",
          "value": "3020"
        },
        {
          "name": "I2C_TOOL_SLUG",
          "value": "smart-image-to-cell"
        },
        {
          "name": "LOG_LEVEL",
          "value": "INFO"
        },
        {
          "name": "PLATFORM_WEBHOOK_DUAL_WRITE",
          "value": "true"
        },
        {
          "name": "PLATFORM_WEBHOOK_READ",
          "value": "true"
        },
        {
          "name": "PYTHONUNBUFFERED",
          "value": "1"
        },
        {
          "name": "RUN_LIFECYCLE_POLLER",
          "value": "true"
        },
        {
          "name": "RUN_WEBHOOK_REGISTRAR",
          "value": "true"
        },
        {
          "name": "SMARTQR_SECRET_SYNC_ENABLED",
          "value": "true"
        },
        {
          "name": "SMARTSHEET_WEBHOOK_CALLBACK_BASE_URL",
          "value": "https://webhooks.prodactivelabs.com"
        },
        {
          "name": "WEBHOOK_LIFECYCLE_INTERVAL_S",
          "value": "300"
        },
        {
          "name": "WEBHOOK_REGISTRAR_TOOLS",
          "value": "smart-image-to-cell"
        },
        {
          "name": "WEBHOOK_SECRETS_TTL_S",
          "value": "300"
        }
      ],
      "mountPoints": [],
      "volumesFrom": [],
      "secrets": [
        {
          "name": "REDIS_URL",
          "valueFrom": "arn:aws:secretsmanager:eu-west-2:262252232181:secret:stg/webhook-gateway-env-k5q5Np:REDIS_URL::"
        },
        {
          "name": "SUPABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:eu-west-2:262252232181:secret:stg/webhook-gateway-env-k5q5Np:SUPABASE_URL::"
        },
        {
          "name": "SUPABASE_SERVICE_ROLE_KEY",
          "valueFrom": "arn:aws:secretsmanager:eu-west-2:262252232181:secret:stg/webhook-gateway-env-k5q5Np:SUPABASE_SERVICE_ROLE_KEY::"
        },
        {
          "name": "APP_CRYPTO_KEY",
          "valueFrom": "arn:aws:secretsmanager:eu-west-2:262252232181:secret:stg/webhook-gateway-env-k5q5Np:APP_CRYPTO_KEY::"
        },
        {
          "name": "SMARTSHEET_BROKER_SECRET",
          "valueFrom": "arn:aws:secretsmanager:eu-west-2:262252232181:secret:stg/webhook-gateway-env-k5q5Np:SMARTSHEET_BROKER_SECRET::"
        },
        {
          "name": "GATEWAY_M2M_TOKEN",
          "valueFrom": "arn:aws:secretsmanager:eu-west-2:262252232181:secret:stg/webhook-gateway-env-k5q5Np:GATEWAY_M2M_TOKEN::"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/smarthub-stg/webhook-gateway",
          "awslogs-region": "eu-west-2",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl -f http://localhost:3020/health || exit 1"
        ],
        "interval": 30,
        "timeout": 10,
        "retries": 3,
        "startPeriod": 45
      },
      "systemControls": []
    }
  ],
  "family": "stg-webhook-gateway",
  "taskRoleArn": "arn:aws:iam::262252232181:role/smarthub-stg-ecsTaskRole",
  "executionRoleArn": "arn:aws:iam::262252232181:role/smarthub-stg-ecsTaskExecutionRole",
  "networkMode": "awsvpc",
  "volumes": [],
  "placementConstraints": [],
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "512",
  "memory": "1024"
}
