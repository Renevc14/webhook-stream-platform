    {
      "name": "04 — Backfill",
      "item": [
        {
          "name": "POST /configs/backfill/estimate  (SH-121, read-only)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test('worksheet_id echoed', () => pm.expect(r.worksheet_id).to.be.a('number'));",
                  "pm.test('configs is array', () => pm.expect(r.configs).to.be.an('array'));",
                  "pm.test('totals shape OK', () => {",
                  "  pm.expect(r.totals).to.have.all.keys('bolts_needed', 'bolts_available_in_cap', 'bolts_overage_estimated', 'any_blocked');",
                  "});",
                  "if (r.configs.length > 0) {",
                  "  pm.test('config entry shape OK', () => {",
                  "    pm.expect(r.configs[0]).to.have.all.keys(",
                  "      'config_id', 'config_name', 'config_type',",
                  "      'rows_with_attachments', 'images_needed', 'bolts_per_image',",
                  "      'bolts_needed', 'bolts_available_in_cap', 'bolts_overage_estimated',",
                  "      'has_ceiling', 'blocked', 'block_reason', 'error'",
                  "    );",
                  "  });",
                  "  pm.test('bolts_needed == images_needed × bolts_per_image', () => {",
                  "    const c = r.configs[0];",
                  "    pm.expect(c.bolts_needed).to.eql(c.images_needed * c.bolts_per_image);",
                  "  });",
                  "  pm.test('overage = max(0, needed - available)', () => {",
                  "    const c = r.configs[0];",
                  "    pm.expect(c.bolts_overage_estimated).to.eql(Math.max(0, c.bolts_needed - c.bolts_available_in_cap));",
                  "  });",
                  "}",
                  "console.log('Estimate:', JSON.stringify(r.totals));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-User-ID", "value": "{{user_id}}" },
              { "key": "X-Organization-ID", "value": "{{org_id}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"worksheet_id\": {{worksheet_id}},\n  \"max_pages\": 10\n}"
            },
            "url": {
              "raw": "{{i2c_url}}/configs/backfill/estimate",
              "host": ["{{i2c_url}}"],
              "path": ["configs", "backfill", "estimate"]
            },
            "description": "Pre-backfill bolt usage preview. Read-only — does NOT enqueue the job. See SH-121."
          }
        },
        {
          "name": "POST /configs/backfill  (triggers job)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test('has status field', () => pm.expect(r.status).to.be.a('string'));"
                ]
              }
            }
