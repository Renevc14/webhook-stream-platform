    {
      "name": "99 — Danger zone (destructive)",
      "description": "These have real side effects (delete, cleanup). Don't run without intent.",
      "item": [
        {
          "name": "DELETE /configs/:config_id",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "X-User-ID", "value": "{{user_id}}" },
              { "key": "X-Organization-ID", "value": "{{org_id}}" }
            ],
            "url": {
              "raw": "{{i2c_url}}/configs/{{config_id}}",
              "host": ["{{i2c_url}}"],
              "path": ["configs", "{{config_id}}"]
            },
            "description": "⚠️ DESTRUCTIVE — deletes the config and unregisters its webhook in Smartsheet."
          }
        },
        {
          "name": "DELETE /dlq/cleanup",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "X-User-ID", "value": "{{user_id}}" },
              { "key": "X-Organization-ID", "value": "{{org_id}}" }
