{
  "family": "image-to-cell-3",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "2048",
  "memory": "8192",
  "executionRoleArn": "arn:aws:iam::780593604124:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::780593604124:role/ecsTaskRole",
  "containerDefinitions": [
    {
      "name": "image-to-cell-3",
      "image": "780593604124.dkr.ecr.eu-west-2.amazonaws.com/image-to-cell-3:latest",
      "portMappings": [
        {
          "containerPort": 3011,
          "protocol": "tcp",
          "name": "api-port"
        }
      ],
      "essential": true,
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/image-to-cell-3",
          "awslogs-region": "eu-west-2",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "true"
        }
      },
      "environment": [
        { "name": "ENVIRONMENT", "value": "production" },
        { "name": "HOST", "value": "0.0.0.0" },
        { "name": "PORT", "value": "3011" },
        { "name": "WORKERS", "value": "1" },
        { "name": "PRODUCT_SLUG", "value": "smart-image-to-cell" },
        { "name": "WEBHOOK_LIFECYCLE_ENABLED", "value": "true" },
        { "name": "WEBHOOK_LIFECYCLE_INTERVAL_S", "value": "300" },
        { "name": "WEBHOOK_PROCESSING_MODES", "value": "webhook" },
        { "name": "DLQ_PROCESSOR_ENABLED", "value": "true" },
        { "name": "DLQ_PROCESSOR_INTERVAL_S", "value": "300" },
        { "name": "DLQ_BATCH_SIZE", "value": "20" },
        { "name": "DLQ_MAX_RETRIES", "value": "3" },
        { "name": "ENABLE_POLLING", "value": "false" },
        { "name": "POLLING_INTERVAL_S", "value": "300" },
        { "name": "MAX_CONCURRENT_ORGS", "value": "8" },
        { "name": "MAX_CONCURRENT_ROWS", "value": "4" },
        { "name": "MAX_PARALLEL_IMAGES", "value": "5" },
        { "name": "MAX_CONCURRENT_ATTACHMENTS", "value": "10" },
        { "name": "ENABLE_PARALLEL_IMAGE_PROCESSING", "value": "true" },
        { "name": "SMARTSHEET_MAX_CALLS_PER_MINUTE", "value": "275" },
        { "name": "SMARTSHEET_RATE_INTERVAL_S", "value": "0.25" },
        { "name": "ENABLE_RATE_LIMITING", "value": "true" },
        { "name": "API_RATE_LIMIT", "value": "60" },
        { "name": "API_BURST_SIZE", "value": "10" },
        { "name": "WEBHOOK_RATE_LIMIT", "value": "100" },
        { "name": "WEBHOOK_BURST_SIZE", "value": "20" },
        { "name": "LOG_LEVEL", "value": "INFO" },
        { "name": "LOG_JSON_FORMAT", "value": "true" },
        { "name": "ENABLE_MEMORY_OPTIMIZATION", "value": "true" },
        { "name": "MAX_MEMORY_USAGE_PERCENT", "value": "85" },
        { "name": "HTTP_POOL_CONNECTIONS", "value": "20" },
        { "name": "HTTP_POOL_MAXSIZE", "value": "50" }
      ],
      "secrets": [
        {
          "name": "SUPABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:eu-west-2:780593604124:secret:image-to-cell-env-LtRooW:SUPABASE_URL::"
        },
        {
          "name": "SUPABASE_SERVICE_ROLE_KEY",
          "valueFrom": "arn:aws:secretsmanager:eu-west-2:780593604124:secret:image-to-cell-env-LtRooW:SUPABASE_SERVICE_ROLE_KEY::"
        },
        {
          "name": "APP_CRYPTO_KEY",
          "valueFrom": "arn:aws:secretsmanager:eu-west-2:780593604124:secret:image-to-cell-env-LtRooW:APP_CRYPTO_KEY::"
        },
        {
          "name": "I2C_ADMIN_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:eu-west-2:780593604124:secret:image-to-cell-env-LtRooW:I2C_ADMIN_API_KEY::"
        },
        {
          "name": "SUPABASE_JWT_SECRET",
          "valueFrom": "arn:aws:secretsmanager:eu-west-2:780593604124:secret:image-to-cell-env-LtRooW:SUPABASE_JWT_SECRET::"
        },
        {
          "name": "REDIS_URL",
          "valueFrom": "arn:aws:secretsmanager:eu-west-2:780593604124:secret:image-to-cell-env-LtRooW:REDIS_URL::"
        }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -f http://localhost:3011/health || exit 1"],
        "interval": 30,
        "timeout": 10,
        "retries": 3,
        "startPeriod": 60
      }
    }
  ]
}
