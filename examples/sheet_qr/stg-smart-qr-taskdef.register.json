{
  "containerDefinitions": [
    {
      "name": "smart-qr",
      "image": "262252232181.dkr.ecr.eu-west-2.amazonaws.com/stg-smart-qr:7bafc62-sot",
      "cpu": 0,
      "portMappings": [
        {
          "containerPort": 3021,
          "hostPort": 3021,
          "protocol": "tcp",
          "name": "api-port"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "PRODUCT_SLUG",
          "value": "smart-qr"
        },
        {
          "name": "APP_ENV",
          "value": "staging"
        },
        {
          "name": "PORT",
          "value": "3021"
        },
        {
          "name": "RUN_STREAM_CONSUMER",
          "value": "true"
        },
        {
          "name": "CHANGE_AGENT_ID",
          "value": "smart-qr-v1"
        },
        {
          "name": "ENCRYPT_TOOL_INTERNAL_URL",
          "value": "https://api.prodactivelabs.com"
        },
        {
          "name": "CORS_ORIGIN",
          "value": "https://www.prodactivelabs.com,https://prodactivelabs.com,https://app.prodactivelabs.com"
        },
        {
          "name": "SMARTSHEET_WEBHOOK_CALLBACK_BASE_URL",
          "value": "https://webhooks.prodactivelabs.com"
        },
        {
          "name": "DATABASE_SSL",
          "value": "require"
        },
        {
          "name": "PYTHONUNBUFFERED",
          "value": "1"
        },
        {
          "name": "LOG_LEVEL",
          "value": "INFO"
        },
        {
          "name": "SMARTSHEET_MODE",
          "value": "live"
        },
        {
          "name": "SMARTQR_BILLING_MODE",
          "value": "bolts"
        }
      ],
      "mountPoints": [],
      "volumesFrom": [],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:eu-west-2:262252232181:secret:stg/smart-qr-env-18AuEl:DATABASE_URL::"
        },
        {
          "name": "REDIS_URL",
          "valueFrom": "arn:aws:secretsmanager:eu-west-2:262252232181:secret:stg/smart-qr-env-18AuEl:REDIS_URL::"
        },
        {
          "name": "SUPABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:eu-west-2:262252232181:secret:stg/smart-qr-env-18AuEl:SUPABASE_URL::"
        },
        {
          "name": "SUPABASE_JWT_SECRET",
          "valueFrom": "arn:aws:secretsmanager:eu-west-2:262252232181:secret:stg/smart-qr-env-18AuEl:SUPABASE_JWT_SECRET::"
        },
        {
          "name": "SUPABASE_SERVICE_ROLE_KEY",
          "valueFrom": "arn:aws:secretsmanager:eu-west-2:262252232181:secret:stg/smart-qr-env-18AuEl:SUPABASE_SERVICE_ROLE_KEY::"
        },
        {
          "name": "APP_CRYPTO_KEY",
          "valueFrom": "arn:aws:secretsmanager:eu-west-2:262252232181:secret:stg/smart-qr-env-18AuEl:APP_CRYPTO_KEY::"
        },
        {
          "name": "SMARTSHEET_BROKER_SECRET",
          "valueFrom": "arn:aws:secretsmanager:eu-west-2:262252232181:secret:stg/smart-qr-env-18AuEl:SMARTSHEET_BROKER_SECRET::"
        },
        {
          "name": "GATEWAY_INTERNAL_URL",
          "valueFrom": "arn:aws:secretsmanager:eu-west-2:262252232181:secret:stg/smart-qr-env-18AuEl:GATEWAY_INTERNAL_URL::"
        },
        {
          "name": "GATEWAY_M2M_TOKEN",
          "valueFrom": "arn:aws:secretsmanager:eu-west-2:262252232181:secret:stg/smart-qr-env-18AuEl:GATEWAY_M2M_TOKEN::"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/smarthub-stg/smart-qr",
          "awslogs-region": "eu-west-2",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl -f http://localhost:3021/ready || exit 1"
        ],
        "interval": 30,
        "timeout": 10,
        "retries": 3,
        "startPeriod": 60
      },
      "systemControls": []
    }
  ],
  "family": "stg-smart-qr",
  "taskRoleArn": "arn:aws:iam::262252232181:role/smarthub-stg-ecsTaskRole",
  "executionRoleArn": "arn:aws:iam::262252232181:role/smarthub-stg-ecsTaskExecutionRole",
  "networkMode": "awsvpc",
  "volumes": [],
  "placementConstraints": [],
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "1024",
  "memory": "2048"
}